RewriteEngine On

# Use accueil.html as directory index
DirectoryIndex accueil.html index.html

# Clean URLs -> map to the html files
RewriteRule ^accueil/?$ /accueil.html [L]
RewriteRule ^pack-eup/?$ /pack-eup.html [L]
RewriteRule ^bspp-ps6g/?$ /bspp-ps6g.html [L]
RewriteRule ^PS6G/?$ /bspp-ps6g [L,R=301]
RewriteRule ^bspp-pma/?$ /bspp-pma.html [L]
RewriteRule ^PMA/?$ /bspp-pma [L,R=301]
RewriteRule ^gn-rs3/?$ /gn-rs3.html [L]
RewriteRule ^RS3/?$ /gn-rs3 [L,R=301]
RewriteRule ^sc-nrbce/?$ /sc-nrbce.html [L]
RewriteRule ^NRBCE/?$ /sc-nrbce [L,R=301]
RewriteRule ^pm-rav4/?$ /pm-rav4.html [L]
RewriteRule ^RAV4/?$ /pm-rav4 [L,R=301]
RewriteRule ^gn-duster/?$ /gn-duster.html [L]
RewriteRule ^DUSTER/?$ /gn-duster [L,R=301]
RewriteRule ^adn-edm/?$ /adn-edm.html [L]
RewriteRule ^EDM/?$ /adn-edm [L,R=301]
RewriteRule ^adn-els/?$ /adn-els.html [L]
RewriteRule ^ELS/?$ /adn-els [L,R=301]
RewriteRule ^sdis06-vsav/?$ /sdis06-vsav.html [L]
RewriteRule ^VSAV06/?$ /sdis06-vsav [L,R=301]
RewriteRule ^autre-mastervasp/?$ /autre-mastervasp.html [L]
RewriteRule ^MASTERAMENAGE/?$ /autre-mastervasp [L,R=301]

# If a request is for a file that exists, serve it (default behavior)
# Otherwise, do nothing (avoid forcing SPA fallback)
